{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Transika",
  "colors": {
    "primary": "#15803D",
    "light": "#22C55E",
    "dark": "#16A34A"
  },
  "logo": {
    "light": "/assets/icon.svg",
    "dark": "/assets/icon.svg"
  },
  "favicon": "/assets/icon.svg",
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "search": {
    "prompt": "Search Transika documentation..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "getting-started/authentication",
              "getting-started/environments",
              "getting-started/responses-and-errors",
              "getting-started/pagination",
              "getting-started/scopes-and-prerequisites"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/beneficiaries",
              "guides/tghs-treasury",
              "guides/webhooks",
              "guides/sandbox-testing"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Beneficiaries",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /beneficiaries/networks",
              "POST /beneficiaries/resolve",
              "GET /beneficiaries",
              "POST /beneficiaries",
              "PATCH /beneficiaries/{id}",
              "DELETE /beneficiaries/{id}"
            ]
          },
          {
            "group": "Transactions",
            "openapi": "openapi.yaml",
            "pages": ["GET /transactions"]
          },
          {
            "group": "tGHS",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /tghs",
              "GET /tghs/activities",
              "GET /tghs/redemptions",
              "GET /tghs/redemptions/{id}",
              "POST /tghs/redemptions/{id}/refresh",
              "POST /tghs/payout"
            ]
          },
          {
            "group": "Webhooks",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /webhooks/endpoints",
              "POST /webhooks/endpoints",
              "DELETE /webhooks/endpoints/{id}",
              "POST /webhooks/endpoints/{id}/rotate-secret",
              "POST /webhooks/endpoints/{id}/test"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["bash", "javascript", "python"],
      "defaults": "all",
      "prefill": false,
      "autogenerate": true
    },
    "mdx": {
      "server": "https://sbx-institutional-api.tran-sika.com/v1",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "cursor"],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable"
  }
}
