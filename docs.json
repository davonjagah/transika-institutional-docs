{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Transika",
  "colors": {
    "primary": "#15803D",
    "light": "#22C55E",
    "dark": "#16A34A"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "home",
              "getting-started/quickstart",
              "getting-started/environments",
              "getting-started/authentication",
              "getting-started/responses-and-errors",
              "getting-started/pagination",
              "getting-started/scopes-and-prerequisites"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/beneficiaries",
              "guides/otc-trades",
              "guides/webhooks",
              "guides/tghs-treasury",
              "guides/sandbox-testing"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "description": "Merchant API documentation for Ghana beneficiaries, OTC trades, managed tGHS balances, payouts, and webhooks.",
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "defaults": "all",
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "prefill": false,
      "autogenerate": true
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      },
      "server": "https://sbx-institutional.tran-sika.com/v1"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "search": {
    "prompt": "Search Transika documentation..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/getting-started/quickstart",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/home",
      "permanent": false
    }
  ]
}
